root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

# ktlint reads its rules from here, so the IDE and the command line agree by construction rather
# than by anyone remembering to keep two settings in sync. The style is ktlint's default, taken
# whole: what the formatter does is not up for discussion per file, which is the point of having
# one. `./gradlew ktlintFormat` fixes everything here except an over-long line.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120

# A @Composable returning Unit is PascalCase — that is Compose's own convention, not a preference,
# and camel-casing the 74 of them here would be the wrong code. ktlint provides this knob for
# exactly that reason.
ktlint_function_naming_ignore_when_annotated_with = Composable

[{gradlew,gradlew.bat}]
indent_style = unset
insert_final_newline = unset

[gradle/wrapper/*]
indent_style = unset
insert_final_newline = unset
